# LinkedIn AI Agent Configuration
# Copy this file to .env and fill in your values

# ====================
# LLM Provider Selection
# ====================
# Options: openai, gemini, deepseek
LLM_PROVIDER=openai

# ====================
# API Keys
# ====================
# Get your OpenAI API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Get your Gemini API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Get your DeepSeek API key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ====================
# Model Configuration
# ====================
# OpenAI Models: gpt-4o-mini (cheap), gpt-4o (powerful)
OPENAI_MODEL=gpt-4o-mini

# Gemini Models: gemini-1.5-flash (fast), gemini-1.5-pro (powerful)
GEMINI_MODEL=gemini-1.5-flash

# DeepSeek Models: deepseek-chat (default)
DEEPSEEK_MODEL=deepseek-chat

# ====================
# Agent Settings
# ====================
# Maximum number of refinement iterations (1-10)
MAX_ITERATIONS=5

# Model temperature for creativity (0.0 = focused, 1.0 = creative)
TEMPERATURE=0.7
